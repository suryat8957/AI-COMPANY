# ==============================================================================
# AI Multi-Agent Software Studio - Environment Configuration
# ==============================================================================

# OpenRouter API (Primary: Qwen3.8 27B for Coding + Mercury Decide for Task Routing)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
QWEN_MODEL=qwen/qwen3.8-27b:free
MERCURY_MODEL=inception/mercury-decide:free

# Google Gemini API (Primary: Reasoning, CEO Review, Strategic Planning, QA & Safety Net)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Legacy / Secondary Backup Providers (Groq & Mistral)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=codestral-latest
MISTRAL_FAST_MODEL=mistral-small-latest

# Remediation & Router Controls
MAX_REMEDIATION_LOOPS=2
MERCURY_DECISION_THRESHOLD=0.80

# Database (MongoDB)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ai_company

# Backend API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000